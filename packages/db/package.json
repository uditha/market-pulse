    "migrate:from-sqlite": "tsx src/migrate-from-sqlite.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@lankapulse/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.15.5",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
