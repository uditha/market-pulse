# API + CBSL/news extractors (Python) for Railway Admin scrapes.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-pip \
    ca-certificates \
    libjpeg62-turbo \
    libpng16-16 \
    zlib1g \
    fonts-dejavu-core \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.12.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/web/package.json ./apps/web/package.json
COPY apps/mobile/package.json ./apps/mobile/package.json
COPY services/extractors ./services/extractors

# postinstall creates extractors/.venv; re-install + import-check so PDF deps
# cannot silently go missing (HTML scrapes would still look "ready").
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @lankapulse/shared build \
  && pnpm --filter @lankapulse/db build \
  && pnpm --filter @lankapulse/api build \
  && test -x services/extractors/.venv/bin/python \
  && services/extractors/.venv/bin/pip install --no-cache-dir -r services/extractors/requirements.txt \
  && services/extractors/.venv/bin/python -c "import pdfplumber, httpx, bs4, openpyxl"

ENV HOST=0.0.0.0
ENV NODE_ENV=production
# Scrapers call the same container; PORT is set by Railway at runtime.
ENV API_URL=

EXPOSE 4000

CMD ["pnpm", "--filter", "@lankapulse/api", "start"]
